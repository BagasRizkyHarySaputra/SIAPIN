# ============================================================
# SIAPIN — contoh environment variable
# Salin file ini menjadi `.env` lalu isi nilainya.
#   cp .env.example .env
# ============================================================

# --- Database (SQLite — file lokal, tanpa server terpisah) ---
# Path relatif dihitung dari direktori proyek.
DATABASE_URL="file:./prisma/dev.db"

# --- Auth.js (NextAuth v5) ---
# Wajib. Generate dengan:  npx auth secret  (atau `openssl rand -base64 32`)
AUTH_SECRET=""
# URL aplikasi (dipakai untuk link verifikasi/reset & callback OAuth)
AUTH_URL="http://localhost:3000"

# --- Login Google OAuth (opsional — jika dikosongkan, login Google dinonaktifkan) ---
# Buat kredensial di https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email transaksional via Brevo (opsional) ---
# Jika dikosongkan, aplikasi berjalan dalam "mode simulasi":
# link verifikasi/reset password ditampilkan di layar (tidak dikirim email).
# Ambil API key di https://app.brevo.com/settings/keys/api
RESEND_API_KEY=""
EMAIL_FROM="SIAPIN <email-pengirim@contoh.com>"

# --- Backup database (opsional) ---
# Folder tempat hasil backup disimpan (default: ./backups)
BACKUP_DIR="./backups"
